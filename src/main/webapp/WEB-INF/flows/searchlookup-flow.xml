<?xml version="1.0" encoding="UTF-8"?>
<webflow:flow xmlns:webflow="http://www.springframework.org/schema/webflow" xmlns:ns0="http://www.w3.org/2001/XMLSchema-instance" ns0:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow-2.0.xsd" start-state="searchlookup">
<webflow:on-start>
        <webflow:evaluate expression="lookupcontbean.setupForm"/>
    <webflow:evaluate expression="lookupcontbean.searchLookupValues"/>
    </webflow:on-start>
<webflow:view-state id="searchlookup" view="lookup.search">
        <webflow:transition on="filterReport" to="searchlookup">
            <webflow:evaluate expression="lookupcontbean.bind"/>
            <webflow:evaluate expression="lookupcontbean.searchLookupValues"/>
        </webflow:transition>
    </webflow:view-state>
<webflow:exception-handler bean="exceptionresol"/>
</webflow:flow>
