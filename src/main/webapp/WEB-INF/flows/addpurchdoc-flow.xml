<?xml version="1.0" encoding="UTF-8"?>
<webflow:flow xmlns:webflow="http://www.springframework.org/schema/webflow" xmlns:ns0="http://www.w3.org/2001/XMLSchema-instance" ns0:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow-2.0.xsd" start-state="entersearch">
<webflow:on-start>
        <webflow:evaluate expression="pocont.setupForm"/>
        <webflow:evaluate expression="lookupbean.getDropDownList('podoc_key')" result="flowScope.poDocTypeList"/>
        <webflow:evaluate expression="purchdoccont.searchCreatedPO"/>
    </webflow:on-start>
<webflow:view-state id="entersearch" view="purchdoc.search">
        <webflow:transition on="addpurchdoc" to="addpurchdoc">
            <webflow:evaluate expression="pocont.bind"/>
            <webflow:evaluate expression="purchdoccont.selectPO"/>
        </webflow:transition>
    </webflow:view-state>
<webflow:view-state id="addpurchdoc" view="purchdoc.add">
        <webflow:on-entry>
            <webflow:evaluate expression="purchdoccont.setupForm"/>
            <webflow:evaluate expression="purchdoccont.loadPurchaseDocList"/>
        </webflow:on-entry>
        <webflow:transition on="addpurchdoc" to="addpurchdoc">
            <webflow:evaluate expression="purchdoccont.bind"/>
            <webflow:evaluate expression="purchdoccont.addPurchaseDoc"/>
        </webflow:transition>
        <webflow:transition on="backtosearch" to="entersearch"/>
    </webflow:view-state>
<webflow:exception-handler bean="exceptionresol"/>
</webflow:flow>
